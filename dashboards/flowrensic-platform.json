{
  "apiVersion": "dashboard.grafana.app/v2beta1",
  "kind": "Dashboard",
  "metadata": {
    "name": "flowrensic-platform"
  },
  "spec": {
    "annotations": [
      {
        "kind": "AnnotationQuery",
        "spec": {
          "query": {
            "kind": "DataQuery",
            "group": "grafana",
            "version": "v0",
            "datasource": {
              "name": "-- Grafana --"
            },
            "spec": {}
          },
          "enable": true,
          "hide": true,
          "iconColor": "rgba(0, 211, 255, 1)",
          "name": "Annotations & Alerts",
          "builtIn": true,
          "legacyOptions": {
            "type": "dashboard"
          }
        }
      }
    ],
    "cursorSync": "Off",
    "editable": true,
    "elements": {
      "panel-1": {
        "kind": "Panel",
        "spec": {
          "id": 1,
          "title": "",
          "description": "Each running Flowrensic server, called an instance here, and what it uses and logs. Each line is one instance, named by the address Prometheus reads its metrics at. The CPU and memory of the whole container against its limits are on the sustainability dashboard. The whole section has no data when Prometheus gets no metrics from the servers.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "text",
            "version": "",
            "spec": {
              "options": {
                "mode": "markdown",
                "content": "## Instances\nThe running Flowrensic instances, and what each one uses and logs."
              },
              "fieldConfig": {
                "defaults": {},
                "overrides": []
              }
            }
          }
        }
      },
      "panel-2": {
        "kind": "Panel",
        "spec": {
          "id": 2,
          "title": "Running instances",
          "description": "One row for each Flowrensic server that Prometheus scrapes: its address, its host name, up, the CPU cores it uses and its memory in bytes. Up comes from Prometheus: 1 when the server answered the last scrape, 0 when it did not. Normal: every server you run, with up 1. Bad: up 0, the server is down or cannot be reached; its host name stays for an hour. No data when Prometheus does not scrape the servers under the job name flowrensic, for example when the metrics are only pushed over OTLP.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "",
                      "version": "v0",
                      "spec": {
                        "expr": "(up{job=\"flowrensic\"} * on(instance) group_left(host) last_over_time(flowrensic_instance_info[1h])) or on(instance) up{job=\"flowrensic\"}",
                        "instant": true,
                        "range": false,
                        "format": "table"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "",
                      "version": "v0",
                      "spec": {
                        "expr": "sum by (instance) (rate(flowrensic_process_cpu_time_seconds_total[$__rate_interval]))",
                        "instant": true,
                        "range": false,
                        "format": "table"
                      }
                    },
                    "refId": "B",
                    "hidden": false
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "",
                      "version": "v0",
                      "spec": {
                        "expr": "sum by (instance) (go_memory_used_bytes{job=\"flowrensic\"})",
                        "instant": true,
                        "range": false,
                        "format": "table"
                      }
                    },
                    "refId": "C",
                    "hidden": false
                  }
                }
              ],
              "transformations": [
                {
                  "kind": "joinByField",
                  "spec": {
                    "id": "joinByField",
                    "options": {
                      "byField": "instance",
                      "mode": "outer"
                    }
                  }
                },
                {
                  "kind": "organize",
                  "spec": {
                    "id": "organize",
                    "options": {
                      "excludeByName": {
                        "Time": true,
                        "Time 1": true,
                        "Time 2": true,
                        "Time 3": true,
                        "__name__": true,
                        "job": true,
                        "job 1": true,
                        "job 2": true,
                        "job 3": true,
                        "host 2": true,
                        "host 3": true
                      },
                      "renameByName": {
                        "Value #A": "Up",
                        "Value #B": "CPU cores",
                        "Value #C": "Memory"
                      },
                      "indexByName": {
                        "instance": 0,
                        "host": 1,
                        "Value #A": 2,
                        "Value #B": 3,
                        "Value #C": 4
                      }
                    }
                  }
                }
              ],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "table",
            "version": "",
            "spec": {
              "options": {},
              "fieldConfig": {
                "defaults": {},
                "overrides": [
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "Memory"
                    },
                    "properties": [
                      {
                        "id": "unit",
                        "value": "bytes"
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "CPU cores"
                    },
                    "properties": [
                      {
                        "id": "decimals",
                        "value": 3
                      }
                    ]
                  }
                ]
              }
            }
          }
        }
      },
      "panel-3": {
        "kind": "Panel",
        "spec": {
          "id": 3,
          "title": "CPU load by instance",
          "description": "CPU cores each server process uses: 1 is one full core. It counts the Flowrensic process only, not Postgres or other containers. Normal: low, with short peaks while it pulls or judges runs. Bad: it stays close to the cores the server has; see the CPU against the limit on the sustainability dashboard. No data when Prometheus gets no metrics from the server.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "",
                      "version": "v0",
                      "spec": {
                        "expr": "sum by (instance) (rate(flowrensic_process_cpu_time_seconds_total[$__rate_interval]))",
                        "legendFormat": "{{instance}}"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {},
              "fieldConfig": {
                "defaults": {
                  "unit": "short"
                },
                "overrides": []
              }
            }
          }
        }
      },
      "panel-4": {
        "kind": "Panel",
        "spec": {
          "id": 4,
          "title": "Memory used by instance",
          "description": "Memory the Go runtime of each server holds, in bytes. Normal: up and down around a steady level. Bad: it keeps climbing and does not come back down, a leak; the memory of the container against its limit is on the sustainability dashboard. No data when Prometheus does not scrape the server under the job name flowrensic, since the Go numbers are read with that job name.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "",
                      "version": "v0",
                      "spec": {
                        "expr": "sum by (instance) (go_memory_used_bytes{job=\"flowrensic\"})",
                        "legendFormat": "{{instance}}"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {},
              "fieldConfig": {
                "defaults": {
                  "unit": "bytes"
                },
                "overrides": []
              }
            }
          }
        }
      },
      "panel-5": {
        "kind": "Panel",
        "spec": {
          "id": 5,
          "title": "Network data volume per second by instance (total)",
          "description": "Bytes per second each server read and wrote on its main listener together: the API, the UI and the history downloads. The metrics endpoint is not counted. There is no good or bad value of its own; it follows the requests. A jump with no more requests means larger requests or answers. No data when Prometheus gets no metrics from the server, or before the first request.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "",
                      "version": "v0",
                      "spec": {
                        "expr": "sum by (instance) (rate(flowrensic_http_request_bytes_total[$__rate_interval]) + rate(flowrensic_http_response_bytes_total[$__rate_interval]))",
                        "legendFormat": "{{instance}}"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {},
              "fieldConfig": {
                "defaults": {
                  "unit": "Bps"
                },
                "overrides": []
              }
            }
          }
        }
      },
      "panel-6": {
        "kind": "Panel",
        "spec": {
          "id": 6,
          "title": "Network data volume per second by instance (in / out)",
          "description": "The same bytes as the panel on the left, split in two lines: bytes read in requests and bytes written in answers, per second. Normal: most data comes in from the workers and goes out to the UI. Bad: a line that keeps climbing with no more requests. No data when Prometheus gets no metrics from the server, or before the first request.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "",
                      "version": "v0",
                      "spec": {
                        "expr": "sum by (instance) (rate(flowrensic_http_request_bytes_total[$__rate_interval]))",
                        "legendFormat": "{{instance}} in"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "",
                      "version": "v0",
                      "spec": {
                        "expr": "sum by (instance) (rate(flowrensic_http_response_bytes_total[$__rate_interval]))",
                        "legendFormat": "{{instance}} out"
                      }
                    },
                    "refId": "B",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {},
              "fieldConfig": {
                "defaults": {
                  "unit": "Bps"
                },
                "overrides": []
              }
            }
          }
        }
      },
      "panel-7": {
        "kind": "Panel",
        "spec": {
          "id": 7,
          "title": "Requests per second to instance",
          "description": "HTTP requests each server answered per second on its main listener, whatever the answer: the API, the UI and the history downloads. There is no good or bad value of its own; a drop to 0 while workers run means they stopped sending. No data when Prometheus gets no metrics from the server, or before the first request.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "",
                      "version": "v0",
                      "spec": {
                        "expr": "sum by (instance) (rate(flowrensic_http_requests_total[$__rate_interval]))",
                        "legendFormat": "{{instance}}"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {},
              "fieldConfig": {
                "defaults": {
                  "unit": "reqps"
                },
                "overrides": []
              }
            }
          }
        }
      },
      "panel-8": {
        "kind": "Panel",
        "spec": {
          "id": 8,
          "title": "Response latency p95 by instance",
          "description": "The time in seconds in which 95% of the API calls of each server were answered, over the last few minutes. It counts the calls of the API only, not the pages of the UI or the history downloads. Normal: well under 1 second, the request time limit by default; the limit is drawn for each kind of request on the sustainability dashboard. Bad: a line that climbs or stays high. No data when there was no API call in that time.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "",
                      "version": "v0",
                      "spec": {
                        "expr": "histogram_quantile(0.95, sum by (le, instance) (rate(flowrensic_rpc_request_duration_seconds_bucket[$__rate_interval])))",
                        "legendFormat": "{{instance}}"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {},
              "fieldConfig": {
                "defaults": {
                  "unit": "s"
                },
                "overrides": []
              }
            }
          }
        }
      },
      "panel-9": {
        "kind": "Panel",
        "spec": {
          "id": 9,
          "title": "Errors per second by instance",
          "description": "Log lines at level error that each server wrote per second. Normal: 0. Bad: above 0, something failed; read the log of that server for the error. No data only when Prometheus gets no metrics from the server; it shows 0 from the start.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "",
                      "version": "v0",
                      "spec": {
                        "expr": "sum by (instance) (rate(flowrensic_log_messages_total{level=\"error\"}[$__rate_interval]))",
                        "legendFormat": "{{instance}}"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {},
              "fieldConfig": {
                "defaults": {
                  "unit": "ops"
                },
                "overrides": []
              }
            }
          }
        }
      },
      "panel-10": {
        "kind": "Panel",
        "spec": {
          "id": 10,
          "title": "Warns per second by instance",
          "description": "Log lines at level warn that each server wrote per second. Normal: 0 or a few now and then, for example when an engine could not be reached once. Bad: a steady or growing line; read the log of that server. No data only when Prometheus gets no metrics from the server.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "",
                      "version": "v0",
                      "spec": {
                        "expr": "sum by (instance) (rate(flowrensic_log_messages_total{level=\"warn\"}[$__rate_interval]))",
                        "legendFormat": "{{instance}}"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {},
              "fieldConfig": {
                "defaults": {
                  "unit": "ops"
                },
                "overrides": []
              }
            }
          }
        }
      },
      "panel-11": {
        "kind": "Panel",
        "spec": {
          "id": 11,
          "title": "Goroutines leak detector by instance",
          "description": "How many goroutines each server runs, a count. A goroutine is a light thread of the Go runtime. Normal: up and down around a steady level as work comes and goes. Bad: a line that keeps climbing and does not come back down, a leak. No data when Prometheus does not scrape the server under the job name flowrensic, since the Go numbers are read with that job name.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "",
                      "version": "v0",
                      "spec": {
                        "expr": "sum by (instance) (go_goroutine_count{job=\"flowrensic\"})",
                        "legendFormat": "{{instance}}"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {},
              "fieldConfig": {
                "defaults": {},
                "overrides": []
              }
            }
          }
        }
      },
      "panel-12": {
        "kind": "Panel",
        "spec": {
          "id": 12,
          "title": "",
          "description": "How much the database and the blob storage hold, and what retention deleted. The database is Postgres. The blob storage is where the history files are kept: a folder, a MinIO bucket or an S3 bucket. Each panel is one value for the whole install, so several servers on one database show the same number. The whole section has no data when Prometheus gets no metrics from the servers.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "text",
            "version": "",
            "spec": {
              "options": {
                "mode": "markdown",
                "content": "## Storage\nThe database on the left and the blob storage on the right."
              },
              "fieldConfig": {
                "defaults": {},
                "overrides": []
              }
            }
          }
        }
      },
      "panel-13": {
        "kind": "Panel",
        "spec": {
          "id": 13,
          "title": "Database storage used volume",
          "description": "Size of the Postgres database, in bytes, as Postgres reports it. Normal: it grows with use and levels off once retention deletes old data. Bad: it keeps growing toward the store size limit, 10 GB by default for the database and the history files together; the sustainability dashboard draws that limit. No data when the server could not read the size, which it logs as a warning.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "",
                      "version": "v0",
                      "spec": {
                        "expr": "max(flowrensic_storage_bytes{backend=\"postgres\"})",
                        "legendFormat": "database"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "",
            "spec": {
              "options": {},
              "fieldConfig": {
                "defaults": {
                  "unit": "bytes"
                },
                "overrides": []
              }
            }
          }
        }
      },
      "panel-14": {
        "kind": "Panel",
        "spec": {
          "id": 14,
          "title": "Blob storage used volume",
          "description": "Size of the history files or objects, in bytes, from the note the database keeps of each file, so the bucket is not listed. Normal: it grows with use and levels off once retention deletes old runs. Bad: it keeps growing toward the store size limit, which counts the database and the history files together. No data when the server could not read the size, which it logs as a warning.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "",
                      "version": "v0",
                      "spec": {
                        "expr": "max(flowrensic_storage_bytes{backend=\"blob\"})",
                        "legendFormat": "blob"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "",
            "spec": {
              "options": {},
              "fieldConfig": {
                "defaults": {
                  "unit": "bytes"
                },
                "overrides": []
              }
            }
          }
        }
      },
      "panel-15": {
        "kind": "Panel",
        "spec": {
          "id": 15,
          "title": "Database storage total records",
          "description": "Rows in the database, a count: runs, findings, activity attempts and engine samples together. There is no good or bad value of its own; it follows use. Bad: it keeps growing and never levels off, so retention may not keep up. No data when the server could not read the counts, which it logs as a warning.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "",
                      "version": "v0",
                      "spec": {
                        "expr": "sum(max by (kind) (flowrensic_stored_items))",
                        "legendFormat": "records"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "",
            "spec": {
              "options": {},
              "fieldConfig": {
                "defaults": {
                  "unit": "short"
                },
                "overrides": []
              }
            }
          }
        }
      },
      "panel-16": {
        "kind": "Panel",
        "spec": {
          "id": 16,
          "title": "Blob storage used total items",
          "description": "History files or objects the blob storage holds, a count, about one for each stored run. There is no good or bad value of its own; it follows the runs stored. Bad: it keeps growing and never levels off, so retention may not keep up. No data when the server could not read the count, which it logs as a warning.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "",
                      "version": "v0",
                      "spec": {
                        "expr": "max(flowrensic_blob_items)",
                        "legendFormat": "items"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "",
            "spec": {
              "options": {},
              "fieldConfig": {
                "defaults": {
                  "unit": "short"
                },
                "overrides": []
              }
            }
          }
        }
      },
      "panel-17": {
        "kind": "Panel",
        "spec": {
          "id": 17,
          "title": "Database evicted items",
